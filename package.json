{
  "name": "x-bestiary",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "analyze": "node --disable-warning=ExperimentalWarning --env-file=.env src/cli.ts",
    "calibrate": "node --disable-warning=ExperimentalWarning --env-file=.env src/calibrate.ts",
    "source-handles": "node --disable-warning=ExperimentalWarning --env-file=.env src/source-handles.ts",
    "spread": "node --disable-warning=ExperimentalWarning src/spread.ts",
    "classify": "node --disable-warning=ExperimentalWarning --env-file=.env src/classify-cli.ts",
    "card": "node --disable-warning=ExperimentalWarning --env-file=.env src/card-cli.ts",
    "rabbit": "node --disable-warning=ExperimentalWarning src/render/rabbit-folio.ts",
    "art-sheet": "node --disable-warning=ExperimentalWarning src/render/art-sheet.ts",
    "render": "node --disable-warning=ExperimentalWarning --env-file=.env src/render-cli.ts",
    "web": "node --disable-warning=ExperimentalWarning --env-file=.env src/web/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/opentype.js": "^1.3.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "opentype.js": "2.0.0"
  }
}
